CONFIG_VERSION=105

BINDEST='/home/irc/services//sbin'
DATDEST='/home/irc/services//lib/ircservices'

TEST_NT='test'
INSTALL='install'
MKDIR='install'
CP_ALL='/bin/cp -dpr'

CC='gcc'
CC_FLAGS='-O2 -fno-strict-aliasing -fno-stack-protector'
CC_LFLAGS=''
CC_LIBS='-lm -lcrypt'

SORTED_LISTS=1
CLEAN_COMPILE=1
MEMCHECKS=0
SHOWALLOCS=0
DUMPCORE=0

STATIC_MODULES=1
CC_SHARED=''
CC_DYN_LFLAGS=''
CC_DYN_LIBS=''
SYMS_NEED_UNDERSCORES=
RANLIB='ranlib'

TYPE_INT8=int8_t
TYPE_INT16=int16_t
TYPE_INT32=int32_t
TYPE_INT64=int64_t
SIZEOF_INT=4
SIZEOF_LONG=8
SIZEOF_PTR=8
SIZEOF_TIME_T=8
MAX_TIME_T='(((time_t)1<<(sizeof(time_t)*8-2))+(((time_t)1<<(sizeof(time_t)*8-2))-1))'
SIZEOF_GID_T=4
HAVE_SOCKLEN_T=1

HAVE_STDINT_H=1
HAVE_STRINGS_H=1
HAVE_SYS_SELECT_H=1
HAVE_SYS_SYSPROTO_H=0

HAVE_STRERROR=1
HAVE_SYS_ERRLIST=0

HAVE_SNPRINTF=0
BAD_SNPRINTF=2
HAVE_HSTRERROR=1
HAVE_STRTOK=1
HAVE_STRICMP=0
HAVE_STRCASECMP=1
HAVE_STRDUP=1
HAVE_STRSPN=1
HAVE_STRSIGNAL=1
HAVE_GETTIMEOFDAY=1
HAVE_SETGRENT=1
HAVE_SETREGID=1
HAVE_UMASK=1
HAVE_FORK=1
HAVE_GETHOSTBYNAME=1
HAVE_GETSETRLIMIT=1
HAVE_CRYPT=1
MISSING=''
